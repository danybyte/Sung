# Public source allowlist. Review new top-level paths and assets before adding them.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/CMakeLists.txt
!/src/
!/qml/
!/helper/
!/scripts/
!/tests/
!/assets/
!/licenses/

/src/*
!/src/*.cpp
!/src/*.h
/qml/*
!/qml/*.qml
/helper/*
!/helper/catalog.py
!/helper/online_artwork.py
!/helper/requirements.txt
!/helper/requirements-windows.txt
/scripts/*
!/scripts/*.sh
!/scripts/*.ps1
!/scripts/*.cmd
# Downloaded toolchains, Qt and runtimes for the Windows build.
/.deps/
/tests/*
!/tests/*.cpp
!/tests/*.h
!/tests/*.py
/assets/*
!/assets/readme-banner.png
!/assets/sung.png
!/assets/sung.desktop
!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
/licenses/*
!/licenses/MaterialSymbols-LICENSE.txt

# Private state, credentials, build products and editor/assistant files.
**/__pycache__/
*.py[cod]
*.log
*.user
*.swp
*.swo
*~
.env
.env.*
*.pem
*.key
*.p12
*.pfx
cookies*
credentials*
secrets*
library.json
settings.json
.DS_Store
.agents/
.codex/
.idea/
.vscode/

# README is the only Markdown file in the public repository.
*.[mM][dD]
*.[mM][aA][rR][kK][dD][oO][wW][nN]
!/README.md
